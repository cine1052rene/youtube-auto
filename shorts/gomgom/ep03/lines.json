{
  "episode": "03 에피쿠로스가 말한 작은 행복",
  "shots": [
    {"id": "01", "type": "V", "model": "wan2_7:5", "narrator": "쾌락주의자라고 하면, 화려하게 즐기는 사람이 떠오르죠?"},
    {"id": "02", "type": "V", "model": "seedance1_5", "narrator": "그런데 쾌락주의 철학자 에피쿠로스는"},
    {"id": "03", "type": "V", "model": "seedance1_5", "narrator": "빵과 물, 그리고 친구면 충분하다고 했어요."},
    {"id": "04", "type": "V", "model": "seedance1_5", "narrator": "작은 치즈 한 단지만 있어도"},
    {"id": "05", "type": "V", "model": "seedance1_5", "narrator": "잔치를 벌일 수 있다고 편지에 썼대요."},
    {"id": "06", "type": "V", "model": "seedance1_5", "narrator": "그가 말한 즐거움은 더 갖는 게 아니라,"},
    {"id": "07", "type": "V", "model": "seedance1_5", "narrator": "마음이 흔들리지 않는 고요함이었어요."},
    {"id": "08", "type": "V", "model": "seedance1_5", "narrator": "곰곰이는 오늘,"},
    {"id": "09", "type": "V", "model": "seedance1_5", "narrator": "따뜻한 빵 한 조각을 천천히 먹어보기로 했어요."},
    {"id": "10", "type": "V", "model": "seedance1_5", "narrator": "한 입, 한 입, 맛을 느끼면서요."},
    {"id": "11", "type": "V", "model": "wan2_7:5", "narrator": "여러분의 치즈 한 단지는 뭔가요?"}
  ],
  "note": "근거: 에피쿠로스의 아타락시아(마음의 평정), 디오게네스 라에르티오스가 전한 편지 속 '치즈 한 단지' 일화. 에피쿠로스는 부엉이 할아버지 캐릭터로 표현. 편지는 화면에 보이지 않게(글자 금지). 곰곰이는 모든 컷에서 입 다문 미소, 마무리 컷에서 날지 않고 앉아 있음."
}
